# Copy this file to .env and change the values
PORT=5000

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: where the SQLite database file is stored (default: database/campus_events.db)
# DB_PATH=./database/campus_events.db

# Front-end URL(s) allowed by CORS (comma separated). Use * to allow all.
CLIENT_URL=http://localhost:5173
